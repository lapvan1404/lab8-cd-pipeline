pipeline {
    agent any

    options {
        disableConcurrentBuilds()
    }

    environment {
        DOCKER_USER     = 'hehe1404'
        DOCKER_IMAGE    = "${DOCKER_USER}/devops-lab8-app"
        DOCKER_TAG = "combined-${env.BUILD_NUMBER}"

        CI_IMAGE        = "devops-lab8-app:ci-${env.BUILD_NUMBER}"
        CI_CONTAINER    = "lab8-ci-test-${env.BUILD_NUMBER}"
        CI_PORT         = '3003'

        CONTAINER_NAME  = 'lab8-cd-production'
        APP_PORT        = '3002'
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'STEP 1: CHECKOUT SOURCE CODE'
                checkout scm
            }
        }

        // ========== CI: LAB 7 ADAPTED FOR NODE.JS ==========

        stage('CI: Build Test Image') {
            steps {
                echo 'STEP 2: CI BUILD'
                sh '''
                    docker build -t ${CI_IMAGE} .
                '''
            }
        }

        stage('CI: Smoke Test') {
            steps {
                echo 'STEP 3: CI TEST'
                sh '''
                    docker rm -f ${CI_CONTAINER} 2>/dev/null || true

                    docker run -d \
                        --name ${CI_CONTAINER} \
                        -p ${CI_PORT}:3000 \
                        ${CI_IMAGE}

                    HEALTH_URL="http://host.docker.internal:${CI_PORT}/health"
                    APP_URL="http://host.docker.internal:${CI_PORT}/"

                    # Wait for application readiness
                    for attempt in $(seq 1 15); do
                        if curl -fsS "$HEALTH_URL" >/tmp/lab8-health-${BUILD_NUMBER}.json; then
                            echo "Application ready on attempt ${attempt}"
                            cat /tmp/lab8-health-${BUILD_NUMBER}.json
                            break
                        fi
                        sleep 2
                    done

                    # Verify health endpoint
                    health=$(curl -fsS "$HEALTH_URL")
                    echo "$health"
                    echo "$health" | grep -q '"status":"OK"'

                    # Verify application endpoint
                    response=$(curl -fsS "$APP_URL")
                    echo "$response"
                    echo "$response" | grep -q '"version":"2.0.0"'

                    echo "CI TEST PASSED"

                    docker rm -f ${CI_CONTAINER}
                '''
            }
        }

        // ========== CD: LAB 8 ==========

        stage('CD: Docker Build') {
            steps {
                echo 'STEP 4: BUILD PRODUCTION IMAGE'
                sh '''
                    docker build \
                        -t ${DOCKER_IMAGE}:${DOCKER_TAG} \
                        -t ${DOCKER_IMAGE}:latest \
                        .
                '''
            }
        }

        stage('CD: Docker Scan') {
            steps {
                echo 'STEP 5: SCAN IMAGE'
                sh '''
                    docker scout quickview ${DOCKER_IMAGE}:${DOCKER_TAG} || echo "Scout not available - skip"
                '''
            }
        }

        stage('CD: Push to Registry') {
            steps {
                echo 'STEP 6: PUSH TO DOCKER HUB'

                withCredentials([usernamePassword(
                    credentialsId: 'docker-hub-credentials_1',
                    usernameVariable: 'HUB_USER',
                    passwordVariable: 'HUB_PASS'
                )]) {
                    sh '''
                        echo "$HUB_PASS" | docker login \
                            -u "$HUB_USER" --password-stdin

                        docker push ${DOCKER_IMAGE}:${DOCKER_TAG}
                        docker push ${DOCKER_IMAGE}:latest
                    '''
                }
            }
        }

        stage('CD: Deploy Container') {
            steps {
                echo 'STEP 7: DEPLOY APPLICATION'
                sh '''
                    docker stop ${CONTAINER_NAME} 2>/dev/null || true
                    docker rm ${CONTAINER_NAME} 2>/dev/null || true

                    docker run -d \
                        --name ${CONTAINER_NAME} \
                        -p ${APP_PORT}:3000 \
                        --restart unless-stopped \
                        ${DOCKER_IMAGE}:${DOCKER_TAG}
                '''
            }
        }

        stage('CD: Verify Deploy') {
            steps {
                echo 'STEP 8: VERIFY PRODUCTION'
                sh '''
                    sleep 3

                    curl -f http://host.docker.internal:3002/health

                    response=$(curl -fsS http://host.docker.internal:3002/)
                    echo "$response"
                    echo "$response" | grep -q '"version":"2.0.0"'

                    echo "CI/CD PIPELINE SUCCESS"
                '''
            }
        }
    }

    post {
        success {
            echo "CI/CD SUCCESS - ${DOCKER_IMAGE}:${DOCKER_TAG}"
        }

        failure {
            echo "CI/CD FAILED - Check Console Output"
        }

        always {
            sh '''
                docker rm -f ${CI_CONTAINER} 2>/dev/null || true
                docker rmi ${CI_IMAGE} 2>/dev/null || true
            '''
            cleanWs()
        }
    }
}